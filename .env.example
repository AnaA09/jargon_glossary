# Optional: add an OpenRouter API key to use AI extraction.
# Without it, the app runs in a local demo mode for common procurement terms.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openrouter/auto
APP_URL=http://localhost:8000

# Add a Mistral API key to read uploaded PDFs with OCR.
MISTRAL_API_KEY=
MISTRAL_OCR_MODEL=mistral-ocr-latest
